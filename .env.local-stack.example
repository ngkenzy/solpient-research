# Local infrastructure only. Copy to .env.local-stack and do not commit that file.
SOLPIENT_DB_USER=solpient
SOLPIENT_DB_PASSWORD=replace-with-a-local-password
SOLPIENT_DB_NAME=solpient
SOLPIENT_DB_PORT=55432
SOLPIENT_DATA_API_PORT=54321

# Point the current app at the self-owned local PostgREST bridge.
# The values below intentionally preserve compatibility while the query layer
# is migrated away from @supabase/supabase-js.
NEXT_PUBLIC_SOLPIENT_DATA_API_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SOLPIENT_DATA_API_KEY=local-dev-only
SOLPIENT_ADMIN_DATA_API_URL=http://127.0.0.1:54321
SOLPIENT_ADMIN_DATA_API_KEY=local-dev-only
# SOLPIENT_JWT_SECRET=<paste from Supabase dashboard, never commit>
# Copy from: Supabase dashboard -> project Settings -> API -> "JWT Secret".
# This lets local PostgREST validate Supabase-cloud-issued JWTs so auth.uid()
# (used by RLS) reflects the real signed-in user. Leave unset to keep the
# previous anonymous-only behavior. Never commit the value.

# --- Hybrid auth: Supabase cloud stays the auth server ---
# The local bridge is DATA-PLANE ONLY (PostgREST has no /auth/v1), so auth and
# session calls (supabase.auth.*) keep going to Supabase cloud. The auth
# client factory (lib/supabase/auth-client.ts) reads ONLY these variables and
# will never pick up the local bridge above.
# Uncomment and fill in to enable sign-in / session flows against the cloud:
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
