# Local infrastructure only. Copy to .env.local-stack and do not commit that file.
SOLPIENT_DB_USER=solpient
SOLPIENT_DB_PASSWORD=replace-with-a-local-password
SOLPIENT_DB_NAME=solpient
SOLPIENT_DB_PORT=5432
SOLPIENT_DATA_API_PORT=54321

# Point the current app at the self-owned local PostgREST bridge.
# The values below intentionally preserve compatibility while the query layer
# is migrated away from @supabase/supabase-js.
NEXT_PUBLIC_SOLPIENT_DATA_API_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SOLPIENT_DATA_API_KEY=local-dev-only
SOLPIENT_ADMIN_DATA_API_URL=http://127.0.0.1:54321
SOLPIENT_ADMIN_DATA_API_KEY=local-dev-only
